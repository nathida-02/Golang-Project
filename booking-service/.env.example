# Copy this file to .env (or set these in docker-compose.yml / your shell)
# before running booking-service.

# --- Database (booking_db, its own Postgres instance per the team's
#     "database per service" design — see Database__2_.pdf) ---
# Values below target running booking-service locally (go run) against the
# containers from docker-compose.example.yml (booking-db on host port 5434).
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=bookingpass
DB_NAME=booking_db
DB_PORT=5434

# --- Service port ---
PORT=8083

# --- Other teammates' services, called directly (bypassing Kong), the same
#     way order-service calls product-service in the original demo.
#     Leave a URL blank/unset to skip that integration during standalone
#     development (see TUTORIAL.md "Standalone mode"). ---

# Facility Service: used to validate facility_id on booking creation and to
# look up a facility's display name for booking list responses.
# Expected endpoint: GET {FACILITY_SERVICE_URL}/facilities/:id
FACILITY_SERVICE_URL=http://localhost:8082/api

# Notification Service: called (best-effort, non-blocking) whenever a
# booking is created/approved/rejected (see notification-service/EVENTS.md).
# Endpoint: POST {NOTIFICATION_SERVICE_URL}/internal/events
# INTERNAL_API_KEY must equal notification-service's INTERNAL_API_KEY.
NOTIFICATION_SERVICE_URL=http://localhost:8084
INTERNAL_API_KEY=dev-internal-key

# Auth Service: maps the Keycloak user (token "sub") to users.id.
# Endpoint: GET {AUTH_SERVICE_URL}/api/users/me (caller's token forwarded)
AUTH_SERVICE_URL=http://localhost:8081

# --- Keycloak: used to verify access token signatures ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=unibook
# Set when the service reaches Keycloak by a different hostname than users
# do (e.g. in Docker: KEYCLOAK_URL=http://keycloak:8080).
# KEYCLOAK_ISSUER=http://localhost:8080/realms/unibook
